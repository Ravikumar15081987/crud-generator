use App\Services\Contracts\{{ model }}ServiceInterface;

class {{ class }} extends Controller
{
    public function __construct(protected {{ model }}ServiceInterface $service) {}

    public function index() {
        ${{ modelVariable }}s = $this->service->getAll();
        return view('{{ modelVariable }}.index', compact('{{ modelVariable }}s'));
    }

    public function create() {
        return view('{{ modelVariable }}.create');
    }

    public function store(Store{{ model }}Request $request) {
        $this->service->create($request->validated());
