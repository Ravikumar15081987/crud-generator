        ${{ modelVariable }} = $this->service->getById($id);
        return view('{{ modelVariable }}.edit', compact('{{ modelVariable }}'));
    }

    public function update(Update{{ model }}Request $request, $id) {
        $this->service->update($id, $request->validated());
        return redirect()->route('{{ modelVariable }}s.index')->with('success', 'Updated successfully.');
    }

    public function destroy($id) {
        $this->service->delete($id);
