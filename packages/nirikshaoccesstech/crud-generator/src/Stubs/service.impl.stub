<?php

namespace App\Services\Implementation;

use App\Services\Contracts\{{ model }}ServiceInterface;
use App\Repositories\Contracts\{{ model }}RepositoryInterface;
use App\Traits\HandlesSafeTransactions;

class {{ class }} implements {{ model }}ServiceInterface
{
    use HandlesSafeTransactions;

    public function __construct(protected {{ model }}RepositoryInterface $repository) {}

    public function getAll()
    {
        return $this->repository->all();
    }

    public function getById($id)
    {
        return $this->repository->find($id);
    }

    public function create(array $data)
    {
        return $this->executeSafeTransaction(function () use ($data) {
            return $this->repository->create($data);
        });
    }

    public function update($id, array $data)
    {
        return $this->executeSafeTransaction(function () use ($id, $data) {
            return $this->repository->update($id, $data);
        });
    }

    public function delete($id)
    {
        return $this->executeSafeTransaction(function () use ($id) {
            return $this->repository->delete($id);
        });
    }
}