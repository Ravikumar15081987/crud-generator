                    <div class="table-responsive text-nowrap overflow-visible pb-4">
                        <table class="table-custom">
                            <thead>
                            <tr>
                                @foreach ($columns as $column)
                                    @if (!isset($column['field']) || $this->isColumnVisible($column['field']))
                                        <th @if (isset($column['field']) && ($column['sortable'] ?? true))
                                                data-sort-field="{{ $column['field'] }}" style="cursor: pointer; user-select: none;"
                                            class="position-relative sortable-header" @else style="user-select: none;" @endif>
                                            <div class="d-flex align-items-center text-nowrap">
                                                {{ $column['label'] ?? '' }}
                                                @if (isset($column['field']) && $sortBy === $column['field'])
                                                    <span class="ms-1 text-white opacity-75">
                                                            <i class="ri-arrow-{{ $sortDirection === 'asc' ? 'up' : 'down' }}-s-fill"></i>
                                                        </span>
                                                @endif
                                            </div>
                                        </th>
                                    @endif
                                @endforeach
                            </tr>
                            </thead>
                            <tbody>

                            @if ($isLoading)
                                {{-- Skeleton Loading --}}
                                @php
                                    $visibleColumnsCount = count(array_filter($columns, function ($col) {
                                        return (!isset($col['field']) && isset($col['view'])) || (isset($col['field']) && $this->isColumnVisible($col['field']));
                                    }));
                                @endphp
                                @for ($i = 0; $i < (int)$perPage; $i++)
                                    <tr class="placeholder-glow">
                                        @for($c = 0; $c < $visibleColumnsCount; $c++)
                                            <td><div class="placeholder bg-light rounded" style="width: {{ rand(40, 90) }}%; height: 14px;"></div></td>
                                        @endfor
                                    </tr>
                                @endfor
                            @else
                                {{-- Actual Data --}}
                                @forelse ($data as $row)
                                    <tr @if ($this->isRowClickable) wire:click="handleRowClick('{{ $row['_model']->getKey() }}')" class="row-hover" @endif>
                                        @foreach ($columns as $column)
                                            @if (!isset($column['field']) || $this->isColumnVisible($column['field']))
                                                <td>
                                                    @if (isset($column['view']))
                                                        @php
                                                            $rowData = is_object($row) ? $row->toArray() : (is_array($row) ? $row : []);
                                                            $viewData = ['data' => $rowData];
                                                            if (is_object($row)) { $viewData['_model'] = $row; }
                                                        @endphp
                                                        @include($column['view'], $viewData)
                                                    @elseif (isset($column['field']))
                                                        <span class="fw-medium text-secondary">{{ $this->getColumnData($column['field'], $row) }}</span>
                                                    @endif
                                                </td>
                                            @endif
                                        @endforeach
                                    </tr>
                                @empty
                                    <tr>
                                        @php
                                            $visibleColumnsCount = count(array_filter($columns, function ($col) {
                                                return (!isset($col['field']) && isset($col['view'])) || (isset($col['field']) && $this->isColumnVisible($col['field']));
                                            }));
                                        @endphp
                                        <td colspan="{{ $visibleColumnsCount }}" class="text-center py-4 text-muted fw-medium small">
                                            No records found.
                                        </td>
                                    </tr>
                                @endforelse
                            @endif
                            </tbody>
                        </table>
                    </div>
                </div>

                {{-- PAGINATION --}}
                <div class="bg-white border border-light-subtle shadow-sm p-3 rounded-custom d-flex flex-column flex-md-row justify-content-between align-items-center mt-2">
                    <div class="mb-2 mb-md-0 fw-medium" style="font-size: 0.85rem; color: #162f64;">
                        @php
                            $start = ($page - 1) * $perPage + 1;
                            $end = min($page * $perPage, $totalRecords);
                        @endphp
                        Showing <span class="fw-bold">{{ $start }}</span> to <span class="fw-bold">{{ $end }}</span> of <span class="fw-bold">{{ $totalRecords }}</span> entries
                    </div>

                    <nav aria-label="Page navigation">
                        <ul class="pagination pagination-sm mb-0 gap-1 align-items-center">
                            <li class="page-item {{ $page === 1 ? 'disabled' : '' }}">
                                <a class="page-link border-0 text-muted bg-transparent px-1" wire:click="firstPage" href="javascript:void(0);">
                                    <i class="ri-skip-left-line"></i>
                                </a>
                            </li>
                            <li class="page-item {{ $page === 1 ? 'disabled' : '' }}">
                                <a class="page-link border-0 text-muted bg-transparent px-1" wire:click="previousPage" href="javascript:void(0);">
                                    <i class="ri-arrow-left-s-line"></i>
                                </a>
                            </li>

                            @php
                                $maxVisiblePages = 3;
                                $half = floor($maxVisiblePages / 2);
                                $start = max(1, $page - $half);
                                $end = min($start + $maxVisiblePages - 1, $totalPages);
                                if ($end - $start + 1 < $maxVisiblePages) { $start=max(1, $end - $maxVisiblePages + 1); }
                            @endphp

                            @for ($i = $start; $i <= $end; $i++)
                                <li class="page-item {{ $page == $i ? 'active' : '' }}">
                                    <a class="page-link custom-page-link" wire:click="gotoPage({{ $i }})" href="javascript:void(0);">
                                        {{ $i }}
                                    </a>
                                </li>
                            @endfor

                            <li class="page-item {{ $page === $totalPages ? 'disabled' : '' }}">
                                <a class="page-link border-0 text-muted bg-transparent px-1" wire:click="nextPage" href="javascript:void(0);">
                                    <i class="ri-arrow-right-s-line"></i>
                                </a>
                            </li>
                            <li class="page-item {{ $page === $totalPages ? 'disabled' : '' }}">
                                <a class="page-link border-0 text-muted bg-transparent px-1" wire:click="lastPage" href="javascript:void(0);">
                                    <i class="ri-skip-right-line"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>

