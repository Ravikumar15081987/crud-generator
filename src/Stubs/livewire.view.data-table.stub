        <script>
            function handleSortClick(event) {
                event.preventDefault();
                const field = event.currentTarget.getAttribute('data-sort-field');
                if (field) {
                    const component = window.Livewire.find('{{ $__livewire->getId() }}');
                    if (component) component.call('sort', field);
                }
            }
            document.addEventListener('DOMContentLoaded', function() {
                document.querySelectorAll('[data-sort-field]').forEach(header => {
                    header.addEventListener('click', handleSortClick);
                });
                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.map(function(tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
            });
        </script>
    </div>
</div>
