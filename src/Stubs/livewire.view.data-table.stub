                {{-- TABLE WRAPPER --}}
                <div class="position-relative">

                    {{-- Loading Overlay --}}
                    <div wire:loading.flex class="position-absolute top-0 start-0 w-100 h-100 align-items-center justify-content-center" style="z-index: 5; background-color: rgba(248, 250, 252, 0.6); backdrop-filter: blur(2px); border-radius: 8px;">
                        <div class="spinner-border text-primary border-3" style="width: 2rem; height: 2rem;" role="status"></div>
