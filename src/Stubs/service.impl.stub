<?php

namespace App\Services\Implementation;

use App\Services\Contracts\{{ modelName }}ServiceInterface;
use App\Repositories\Contracts\{{ modelName }}RepositoryInterface;
use App\Traits\HandlesSafeTransactions;
use App\Services\Contracts\ProcessBase64ImagesServiceInterface;

class {{ modelName }}Service implements {{ modelName }}ServiceInterface
{
    use HandlesSafeTransactions;

    protected ${{ modelNameLowerCase }}Repository;
    protected $imageProcessor;

    public function __construct(
        {{ modelName }}RepositoryInterface ${{ modelNameLowerCase }}Repository,
        ProcessBase64ImagesServiceInterface $imageProcessor
    ) {
        $this->{{ modelNameLowerCase }}Repository = ${{ modelNameLowerCase }}Repository;
        $this->imageProcessor = $imageProcessor;
    }

    public function all()
    {
        return $this->{{ modelNameLowerCase }}Repository->all();
    }

    public function find($id)
    {
        return $this->{{ modelNameLowerCase }}Repository->find($id);
    }

    public function create(array $data)
    {
        return $this->executeSafeTransaction(function () use ($data) {
            $record = $this->{{ modelNameLowerCase }}Repository->create($data);
            
            // Auto-process TinyMCE Base64 images if a rich text field exists
            if (isset($data['description'])) {
                $processedContent = $this->imageProcessor->process(
                    $data['description'], 
                    $record, 
                    '{{ modelNameUpperCase }}_MEDIA'
                );
                $this->{{ modelNameLowerCase }}Repository->update($record->id, ['description' => $processedContent]);
            }

            return $record;
        });
    }

    public function update($id, array $data)
    {
        return $this->executeSafeTransaction(function () use ($id, $data) {
            $record = $this->{{ modelNameLowerCase }}Repository->find($id);

            // Auto-process TinyMCE Base64 images if a rich text field exists
            if (isset($data['description'])) {
                $data['description'] = $this->imageProcessor->process(
                    $data['description'], 
                    $record, 
                    '{{ modelNameUpperCase }}_MEDIA'
                );
            }

            return $this->{{ modelNameLowerCase }}Repository->update($id, $data);
        });
    }

    public function delete($id)
    {
        return $this->executeSafeTransaction(function () use ($id) {
            return $this->{{ modelNameLowerCase }}Repository->delete($id);
        });
    }

    public function getTrashed()
    {
        return $this->{{ modelNameLowerCase }}Repository->getTrashed();
    }

    public function restore($id)
    {
        return $this->executeSafeTransaction(function () use ($id) {
            return $this->{{ modelNameLowerCase }}Repository->restore($id);
        });
    }

    public function forceDelete($id)
    {
        return $this->executeSafeTransaction(function () use ($id) {
            return $this->{{ modelNameLowerCase }}Repository->forceDelete($id);
        });
    }
}