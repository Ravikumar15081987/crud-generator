<?php

namespace App\Http\Requests;

use App\Facades\UiNotify;
use Illuminate\Auth\Access\AuthorizationException;
use Illuminate\Contracts\Validation\Validator;
use Illuminate\Foundation\Http\FormRequest;
use Illuminate\Support\Facades\Log;
use Illuminate\Validation\ValidationException;

abstract class BaseRequest extends FormRequest
{
    protected function failedValidation(Validator $validator): void
    {
        Log::info('Validation failed in '.static::class, [
            'errors' => $validator->errors()->messages(),
            'request_url' => $this->fullUrl(),
            'user_id' => auth()->id(),
        ]);

        if (! $this->expectsJson()) {
            if (config('app.debug')) {
                $firstError = $validator->errors()->first();
                UiNotify::error("Validation Error: {$firstError}");
            } else {
                UiNotify::error('There were errors with your submission. Please check the form.');
                parent::failedValidation($validator);
            }
        }

        throw new ValidationException($validator);
    }

    protected function failedAuthorization(): void
    {
        Log::warning('Authorization failed in '.static::class, [
            'request_url' => $this->fullUrl(),
            'user_id' => auth()->id(),
            'ip_address' => $this->ip(),
        ]);

        if (! $this->expectsJson()) {
            UiNotify::error('You do not have permission to perform this action.');
        }

        throw new AuthorizationException('This action is unauthorized.');
    }
}