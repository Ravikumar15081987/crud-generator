<?php

namespace {{ namespace }};

use App\Http\Controllers\Controller;
use {{ requestNamespace }}\Store{{ modelName }}Request;
use {{ requestNamespace }}\Update{{ modelName }}Request;
use App\Services\Contracts\{{ modelName }}ServiceInterface;
use App\Facades\UiNotify;

class {{ modelName }}Controller extends Controller
{
    protected $service;

    public function __construct({{ modelName }}ServiceInterface $service)
    {
        $this->service = $service;
    }

    public function index()
    {
        $filtersConfig = [];        
        return view('{{ viewPrefix }}{{ model-plural-kebab }}.index', compact('filtersConfig'));
    }

    public function create()
    {
        return view('{{ viewPrefix }}{{ model-plural-kebab }}.create');
    }

    public function store(Store{{ modelName }}Request $request)
    {
        $this->service->create($request->validated());

        UiNotify::success('{{ modelName }} created successfully!', 'Success');

        return redirect()->route('{{ viewPrefix }}{{ model-plural-kebab }}.index');
    }

    public function show($id)
    {
        ${{ modelNameLowerCase }} = $this->service->find($id);

        return view('{{ viewPrefix }}{{ model-plural-kebab }}.show', compact('{{ modelNameLowerCase }}'));
    }

    public function edit($id)
    {
        ${{ modelNameLowerCase }} = $this->service->find($id);

        return view('{{ viewPrefix }}{{ model-plural-kebab }}.edit', compact('{{ modelNameLowerCase }}'));
    }

    public function update(Update{{ modelName }}Request $request, $id)
    {
        $this->service->update($id, $request->validated());

        UiNotify::success('{{ modelName }} updated successfully!', 'Success');

        return redirect()->route('{{ viewPrefix }}{{ model-plural-kebab }}.index');
    }

    public function destroy($id)
    {
        $this->service->delete($id);

        UiNotify::success('{{ modelName }} deleted successfully!', 'Success');

        return redirect()->route('{{ viewPrefix }}{{ model-plural-kebab }}.index');
    }

    public function trashed()
    {
        // For Livewire, you can point this to a specific trashed view, 
        // or just pass a flag to the main index view.
        return view('{{ viewPrefix }}{{ model-plural-kebab }}.trashed');
    }

    public function restore($id)
    {
        $this->{{ modelNameLowerCase }}Service->restore($id);
        UiNotify::success('{{ modelName }} restored successfully.');
        return redirect()->back();
    }

    public function forceDelete($id)
    {
        $this->{{ modelNameLowerCase }}Service->forceDelete($id);
        UiNotify::success('{{ modelName }} permanently deleted.');
        return redirect()->back();
    }
}