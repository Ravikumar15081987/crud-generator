{
    "name": "nirikshaoccesstech/crud-generator",
    "description": "A Laravel package to scaffold Repository-Service CRUD architecture.",
    "type": "library",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "spatie/laravel-permission": "^5.0|^6.0"
    },
    "autoload": {
        "psr-4": {
            "NirikshaOccesstech\\CrudGenerator\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NirikshaOccesstech\\CrudGenerator\\CrudGeneratorServiceProvider"
            ]
        }
    }
}